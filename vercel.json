{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/archive", "destination": "/project.html" },
    { "source": "/projects/:slug", "destination": "/project.html" }
  ]
}
